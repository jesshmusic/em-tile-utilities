# build-info.json is a local build counter generated by `vite build` (see
# vite.config.ts), and is genuinely untracked as of 2.2.0. Nothing imports it
# any more -- src/main.ts and src/dialogs/tile-manager.ts read the
# `__BUILD_NUMBER__` / `__MODULE_VERSION__` compile-time constants instead (see
# env.d.ts), so a fresh clone builds fine without the file and it no longer
# churns into every diff.
build-info.json


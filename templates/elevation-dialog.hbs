{{! Elevation Region Configuration }}
<fieldset class="basic-info-section">
  <legend>
    {{localize "EMPUZZLES.BasicInfo"}}
  </legend>

  <div class="form-group">
    <label for="regionName">{{localize "EMPUZZLES.RegionName"}}</label>
    <input type="text" id="regionName" name="regionName" value="{{regionName}}" />
    <p class="hint">{{localize "EMPUZZLES.RegionNameHint"}}</p>
  </div>
</fieldset>

{{! Elevation Settings Section }}
<fieldset class="elevation-settings-section">
  <legend>
    {{localize "EMPUZZLES.ElevationSettings"}}
  </legend>

  <div class="form-group">
    <label for="elevationOnEnter">{{localize "EMPUZZLES.ElevationOnEnter"}}</label>
    <input type="number" id="elevationOnEnter" name="elevationOnEnter" value="{{elevationOnEnter}}" step="1" />
    <p class="hint">{{localize "EMPUZZLES.ElevationOnEnterHint"}}</p>
  </div>

  <div class="form-group">
    <label for="elevationOnExit">{{localize "EMPUZZLES.ElevationOnExit"}}</label>
    <input type="number" id="elevationOnExit" name="elevationOnExit" value="{{elevationOnExit}}" step="1" />
    <p class="hint">{{localize "EMPUZZLES.ElevationOnExitHint"}}</p>
  </div>

  {{! Movement action filter }}
  <div class="form-group">
    <label>{{localize "EMPUZZLES.MovementActions"}}</label>
    <div class="movement-action-list">
      {{#each movementActionOptions as |action|}}
        <label class="movement-action">
          <input type="checkbox" name="regionMovementAction" value="{{action.value}}" {{#if action.checked}}checked{{/if}} />
          {{action.label}}
        </label>
      {{/each}}
    </div>
    <p class="hint">{{localize "EMPUZZLES.MovementActionsHint"}}</p>
  </div>
</fieldset>

{{! Custom Tags Section }}
{{> partials/custom-tags-section customTags=customTags}}

{{! Gas Cloud / Aura Region Configuration }}
<fieldset class="basic-info-section">
  <legend>
    {{localize "EMPUZZLES.BasicInfo"}}
  </legend>

  <div class="form-group">
    <label for="regionName">{{localize "EMPUZZLES.RegionName"}}</label>
    <input type="text" id="regionName" name="regionName" value="{{regionName}}" />
    <p class="hint">{{localize "EMPUZZLES.RegionNameHint"}}</p>
  </div>

  <div class="form-group">
    <label for="mode">{{localize "EMPUZZLES.GasCloudMode"}}</label>
    <select id="mode" name="mode">
      {{#each modeOptions as |option|}}
        <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{localize option.label}}</option>
      {{/each}}
    </select>
    <p class="hint">{{localize "EMPUZZLES.GasCloudModeHint"}}</p>
  </div>
</fieldset>

{{! Emanation-only settings }}
{{#if isEmanation}}
  <fieldset class="gas-cloud-emanation-section">
    <legend>
      {{localize "EMPUZZLES.GasCloudAuraSettings"}}
    </legend>

    <div class="form-group">
      <label for="tokenId">{{localize "EMPUZZLES.GasCloudToken"}}</label>
      <select id="tokenId" name="tokenId">
        {{#each tokenOptions as |token|}}
          <option value="{{token.value}}" {{#if token.selected}}selected{{/if}}>{{token.label}}</option>
        {{/each}}
      </select>
      <p class="hint">{{localize "EMPUZZLES.GasCloudTokenHint"}}</p>
    </div>

    <div class="form-group">
      <label for="range">{{localize "EMPUZZLES.GasCloudRange"}}</label>
      <input type="number" id="range" name="range" value="{{range}}" min="1" step="1" />
      <p class="hint">{{localize "EMPUZZLES.GasCloudRangeHint"}}</p>
    </div>

    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="excludeToken" {{#if excludeToken}}checked{{/if}} />
        {{localize "EMPUZZLES.GasCloudExcludeToken"}}
      </label>
      <p class="hint">{{localize "EMPUZZLES.GasCloudExcludeTokenHint"}}</p>
    </div>

    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="gridBased" {{#if gridBased}}checked{{/if}} />
        {{localize "EMPUZZLES.GasCloudGridBased"}}
      </label>
      <p class="hint">{{localize "EMPUZZLES.GasCloudGridBasedHint"}}</p>
    </div>
  </fieldset>
{{/if}}

{{! Effects }}
<fieldset class="gas-cloud-effects-section">
  <legend>
    {{localize "EMPUZZLES.GasCloudEffects"}}
  </legend>

  <div class="form-group">
    <label>{{localize "EMPUZZLES.GasCloudConditions"}}</label>
    <div class="status-effect-list">
      {{#each statusEffectOptions as |effect|}}
        <label class="status-effect">
          <input type="checkbox" name="statusEffect" value="{{effect.value}}" {{#if effect.checked}}checked{{/if}} />
          {{effect.label}}
        </label>
      {{/each}}
    </div>
    <p class="hint">{{localize "EMPUZZLES.GasCloudConditionsHint"}}</p>
  </div>

  <div class="form-group">
    <label for="effectUuids">{{localize "EMPUZZLES.GasCloudEffectUuids"}}</label>
    <input type="text" id="effectUuids" name="effectUuids" value="{{effectUuids}}" placeholder="Compendium.pack.Item.abc.ActiveEffect.def" />
    <p class="hint">{{localize "EMPUZZLES.GasCloudEffectUuidsHint"}}</p>
  </div>
</fieldset>

{{! Custom Tags Section }}
{{> partials/custom-tags-section customTags=customTags}}

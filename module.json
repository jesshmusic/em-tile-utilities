{
  "id": "em-tile-utilities",
  "title": "Dorman Lakely's Tile Utilities",
  "description": "Create interactive puzzles, traps, and environmental elements in seconds. Point-and-click tools for switches, pressure plates, lights, resets, and more—powered by Monk's Active Tiles.",
  "version": "3.0.1",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "jesshmusic"
    }
  ],
  "documentTypes": {
    "RegionBehavior": {
      "Trap": {},
      "Elevation": {},
      "SoundEffect": {},
      "MovementFilter": {},
      "TriggerTile": {}
    }
  },
  "relationships": {
    "requires": [
      {
        "id": "monks-active-tiles",
        "type": "module",
        "compatibility": {
          "minimum": "14.01",
          "verified": "14.01"
        }
      },
      {
        "id": "tagger",
        "type": "module",
        "compatibility": {
          "minimum": "1.6.0",
          "verified": "1.6.0"
        }
      }
    ],
    "suggests": [
      {
        "id": "monks-tokenbar",
        "type": "module",
        "compatibility": {
          "minimum": "14.01",
          "verified": "14.01"
        }
      },
      {
        "id": "enhanced-region-behavior",
        "type": "module",
        "compatibility": {
          "minimum": "1.5.0",
          "verified": "1.5.0"
        }
      }
    ]
  },
  "scripts": [
    "dist/main.js"
  ],
  "styles": [
    "styles/dialogs.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "url": "https://github.com/jesshmusic/em-tile-utilities",
  "bugs": "https://github.com/jesshmusic/em-tile-utilities/issues/new/choose",
  "changelog": "https://github.com/jesshmusic/em-tile-utilities/blob/main/CHANGELOG.md",
  "manifest": "https://raw.githubusercontent.com/jesshmusic/em-tile-utilities/main/module.json",
  "download": "https://github.com/jesshmusic/em-tile-utilities/releases/download/v3.0.1/module.zip",
  "hotReload": {
    "extensions": [
      "css",
      "hbs",
      "json",
      "js"
    ],
    "paths": [
      "dist",
      "styles",
      "templates",
      "lang"
    ]
  }
}
